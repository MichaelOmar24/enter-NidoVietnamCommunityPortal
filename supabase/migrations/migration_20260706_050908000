
CREATE TABLE IF NOT EXISTS member_recognitions (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  profile_id uuid NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,
  award_title text NOT NULL,
  category text NOT NULL DEFAULT 'community_service',
  description text NOT NULL,
  awarded_date date NOT NULL DEFAULT CURRENT_DATE,
  is_published boolean NOT NULL DEFAULT false,
  awarded_by uuid REFERENCES profiles(id),
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now(),
  CONSTRAINT member_recognitions_category_check CHECK (
    category = ANY (ARRAY[
      'leadership', 'humanitarian', 'business', 'youth', 'community_service', 'cultural', 'academic'
    ])
  )
);

ALTER TABLE member_recognitions ENABLE ROW LEVEL SECURITY;

-- Admins can do everything
CREATE POLICY "Admins manage recognitions" ON member_recognitions
  FOR ALL USING (
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND (is_admin OR is_super_admin))
  );

-- Anyone can read published recognitions
CREATE POLICY "Public reads published recognitions" ON member_recognitions
  FOR SELECT USING (is_published = true);

ALTER PUBLICATION supabase_realtime ADD TABLE "member_recognitions";
