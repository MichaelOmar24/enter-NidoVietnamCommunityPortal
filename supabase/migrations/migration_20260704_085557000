-- Fix: Create a security-definer function that bypasses RLS to check admin status
-- This breaks the infinite recursion in profiles policies

CREATE OR REPLACE FUNCTION public.is_current_user_admin()
RETURNS boolean
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  RETURN EXISTS (
    SELECT 1 FROM profiles 
    WHERE id = auth.uid() AND is_admin = true
  );
END;
$$;

-- Drop all recursive admin policies and replace with the non-recursive function

-- Profiles
DROP POLICY IF EXISTS "Admins can view all profiles" ON profiles;
CREATE POLICY "Admins can view all profiles" ON profiles
FOR ALL USING (public.is_current_user_admin());

