-- 1. Update memberships table
ALTER TABLE memberships
  ADD COLUMN IF NOT EXISTS payment_reference TEXT,
  ADD COLUMN IF NOT EXISTS payment_proof_url TEXT,
  ADD COLUMN IF NOT EXISTS approved_by UUID REFERENCES profiles(id),
  ADD COLUMN IF NOT EXISTS approved_at TIMESTAMPTZ,
  ADD COLUMN IF NOT EXISTS notes TEXT;

-- Drop old stripe column if exists
ALTER TABLE memberships DROP COLUMN IF EXISTS stripe_session_id;

-- Update currency default to VND
ALTER TABLE memberships ALTER COLUMN currency SET DEFAULT 'VND';

-- Update plan_type check constraint
ALTER TABLE memberships DROP CONSTRAINT IF EXISTS memberships_plan_type_check;
ALTER TABLE memberships ADD CONSTRAINT memberships_plan_type_check
  CHECK (plan_type IN ('free','premium','gold'));

-- Update payment_status check to include 'approved' and 'rejected'
ALTER TABLE memberships DROP CONSTRAINT IF EXISTS memberships_payment_status_check;
ALTER TABLE memberships ADD CONSTRAINT memberships_payment_status_check
  CHECK (payment_status IN ('pending','completed','failed','approved','rejected'));

-- 2. Update profiles.membership_type to include 'free' and 'gold'
ALTER TABLE profiles DROP CONSTRAINT IF EXISTS profiles_membership_type_check;
ALTER TABLE profiles ADD CONSTRAINT profiles_membership_type_check
  CHECK (membership_type IN ('free','regular','premium','gold'));

-- 3. Create payment_settings table
CREATE TABLE IF NOT EXISTS payment_settings (
  id UUID NOT NULL DEFAULT uuid_generate_v4() PRIMARY KEY,
  qr_code_url TEXT,
  bank_name TEXT,
  account_name TEXT,
  account_number TEXT,
  bank_branch TEXT,
  transfer_instructions TEXT DEFAULT 'Please transfer the exact amount and include your full name and phone number as the transfer description. Submit your payment reference after completing the transfer.',
  updated_at TIMESTAMPTZ DEFAULT now(),
  updated_by UUID REFERENCES profiles(id)
);

ALTER TABLE payment_settings ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Authenticated users can view payment settings"
  ON payment_settings FOR SELECT
  USING (auth.role() = 'authenticated');

CREATE POLICY "Admins can manage payment settings"
  ON payment_settings FOR ALL
  USING (EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND (is_admin = true OR is_super_admin = true)));

-- Admins can update/approve memberships
CREATE POLICY "Admins can view all memberships"
  ON memberships FOR SELECT
  USING (EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND (is_admin = true OR is_super_admin = true)));

-- Embassy staff can view memberships
CREATE POLICY "Embassy staff can view memberships"
  ON memberships FOR SELECT
  USING (EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND is_embassy_staff = true));

